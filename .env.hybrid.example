# Local hybrid testing configuration. Copy to .env.hybrid; this file is ignored by Git.
# Default false: deterministic Local Mock Mode. Set true to exercise real providers locally.
VERIFACT_LOCAL_REAL_API_MODE=false

# Optional real OpenAI-compatible evidence analysis. Keep blank for Local Mock Mode.
VERIFACT_OPENAI_API_KEY=
VERIFACT_OPENAI_BASE_URL=https://api.openai.com/v1
VERIFACT_OPENAI_MODEL=gpt-4o-mini

# Optional live evidence providers. Leave blank/false until accounts are configured.
VERIFACT_GOOGLE_FACTCHECK_KEY=
VERIFACT_NEWSAPI_KEY=
VERIFACT_GDELT_ENABLED=false

# Optional real local SMTP testing. With Local Mock Mode, reset tokens remain visible only to the local UI.
VERIFACT_SMTP_HOST=
VERIFACT_SMTP_PORT=587
VERIFACT_SMTP_USERNAME=
VERIFACT_SMTP_PASSWORD=
VERIFACT_SMTP_FROM_EMAIL=
VERIFACT_SMTP_FROM_NAME=VeriFact
VERIFACT_SMTP_STARTTLS=true
