flowchart LR
    Browser[User browser]

    subgraph Client[Academic Demo client]
        SPA[React single-page application\nfrontend/src/main.tsx]
        Vite[Vite development server]
    end

    subgraph API[FastAPI application]
        Main[app.main\nAccounts, verification, history, sharing]
        Config[Settings\nAcademic Demo profile]
        Verify[run_verification\nInline evidence workflow]
        Extract[extract_article\nArticle text retrieval]
        Policy[SourcePolicy\nDomain quality classification]
        Providers[enabled_external_providers]
        Analysis[analyze_evidence\nStructured assessment and summary]
        Email[Email service\nOptional account mail]
    end

    subgraph Data[Application data]
        DB[(Supabase PostgreSQL\nor local SQLite)]
        PolicyFile[source_policy.json]
    end

    subgraph External[Configured external services]
        Groq[Groq API]
        Google[Google Fact Check Tools]
        GDELT[GDELT news search]
        NewsAPI[Optional NewsAPI]
        SMTP[Optional SMTP provider]
        Articles[Public article URLs]
    end

    Browser --> SPA
    SPA --> Vite
    Vite -->|API requests| Main
    Main --> Config
    Main --> DB
    Main -->|run inline| Verify
    Main --> Email
    Verify --> DB
    Verify --> Extract
    Verify --> Policy
    Policy --> PolicyFile
    Verify --> Providers
    Verify --> Analysis
    Extract --> Articles
    Providers --> Google
    Providers --> GDELT
    Providers --> NewsAPI
    Analysis --> Groq
    Email --> SMTP

