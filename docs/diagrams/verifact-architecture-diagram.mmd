    classDef store fill:#edf8ef,stroke:#287d3c,color:#153d1d
    classDef external fill:#fff4e5,stroke:#b26a00,color:#5c3600
    classDef edge fill:#f5efff,stroke:#6b4ca3,color:#2e1f51
    class Main,Config,Security,Verify,Extract,Policy,Providers,AI,Queue,Email,WorkerMain,Job,SPA,DevServer,Nginx app
    class DB,Redis,Fixtures,PolicyFile store
    class OpenAI,Google,NewsAPI,GDELT,SMTP,Articles external
    class Caddy edge
