# VeriFact production environment template. Copy to .env.production on the production host; never commit it.
VERIFACT_ENVIRONMENT=production
VERIFACT_MODE=production

# Domain and HTTPS. Configure DNS A/AAAA records for VERIFACT_DOMAIN before deployment.
VERIFACT_DOMAIN=verifact.example
VERIFACT_TLS_EMAIL=admin@verifact.example
VERIFACT_FRONTEND_ORIGIN=https://verifact.example
VERIFACT_PUBLIC_BASE_URL=https://verifact.example
VERIFACT_ADDITIONAL_CORS_ORIGINS=
VERIFACT_ALLOWED_HOSTS=verifact.example
VERIFACT_SECURE_COOKIES=true

# Generate a unique random secret of at least 32 characters; do not reuse the local value.
VERIFACT_SECRET_KEY=
VERIFACT_ACCESS_TOKEN_MINUTES=60

# Persistent Docker service credentials. Set long unique values before deployment.
POSTGRES_DB=verifact
POSTGRES_USER=verifact
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The production Compose file derives these internal service URLs automatically.
# Keep these values only when using externally managed PostgreSQL or Redis.
VERIFACT_DATABASE_URL=postgresql+psycopg://verifact:CHANGE_ME@postgres-host:5432/verifact
VERIFACT_REDIS_URL=redis://:CHANGE_ME@redis-host:6379/0

# Operational limits.
VERIFACT_SCORE_COVERAGE_THRESHOLD=0.60
VERIFACT_MAX_INPUT_CHARS=24000
VERIFACT_MAX_REQUEST_BYTES=300000
VERIFACT_REQUEST_TIMEOUT_SECONDS=45
VERIFACT_RATE_LIMIT_DEFAULT=120/minute
VERIFACT_RATE_LIMIT_AUTH=10/minute
VERIFACT_RATE_LIMIT_SIGNUP=5/minute
VERIFACT_SOURCE_POLICY_PATH=app/fixtures/source_policy.json

# AI and evidence providers. Configure only providers for which you have a production account.
# A missing provider must result in an evidence limitation, never fixture data.
VERIFACT_OPENAI_API_KEY=
VERIFACT_OPENAI_BASE_URL=https://api.openai.com/v1
VERIFACT_OPENAI_MODEL=gpt-4o-mini
VERIFACT_GOOGLE_FACTCHECK_KEY=
VERIFACT_NEWSAPI_KEY=
VERIFACT_GDELT_ENABLED=false

# Production transactional email. Mailpit is for local development only.
VERIFACT_SMTP_HOST=
VERIFACT_SMTP_PORT=587
VERIFACT_SMTP_USERNAME=
VERIFACT_SMTP_PASSWORD=
VERIFACT_SMTP_FROM_EMAIL=no-reply@verifact.example
VERIFACT_SMTP_FROM_NAME=VeriFact
VERIFACT_SMTP_STARTTLS=true
