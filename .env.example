# VeriFact local development defaults. For public deployment, copy .env.production.example instead.
VERIFACT_ENVIRONMENT=development
VERIFACT_MODE=local-fixture
VERIFACT_DATABASE_URL=sqlite:///./verifact.db
VERIFACT_REDIS_URL=
VERIFACT_SECRET_KEY=replace-with-a-long-random-value-in-production
VERIFACT_FRONTEND_ORIGIN=http://localhost:5173
VERIFACT_PUBLIC_BASE_URL=http://localhost:5173
VERIFACT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
VERIFACT_SECURE_COOKIES=false
VERIFACT_SCORE_COVERAGE_THRESHOLD=0.60
VERIFACT_MAX_INPUT_CHARS=24000
VERIFACT_MAX_REQUEST_BYTES=300000
VERIFACT_REQUEST_TIMEOUT_SECONDS=45
VERIFACT_RATE_LIMIT_DEFAULT=120/minute
VERIFACT_RATE_LIMIT_AUTH=10/minute
VERIFACT_RATE_LIMIT_SIGNUP=5/minute
VERIFACT_SOURCE_POLICY_PATH=app/fixtures/source_policy.json

# Optional external providers. In local-fixture mode these are not used.
VERIFACT_OPENAI_API_KEY=
VERIFACT_OPENAI_BASE_URL=
VERIFACT_OPENAI_MODEL=gpt-4o-mini
VERIFACT_GOOGLE_FACTCHECK_KEY=
VERIFACT_NEWSAPI_KEY=
VERIFACT_GDELT_ENABLED=false

# SMTP is optional for local testing. Production uses these settings to send reset emails.
VERIFACT_SMTP_HOST=
VERIFACT_SMTP_PORT=587
VERIFACT_SMTP_USERNAME=
VERIFACT_SMTP_PASSWORD=
VERIFACT_SMTP_FROM_EMAIL=
VERIFACT_SMTP_FROM_NAME=VeriFact
VERIFACT_SMTP_STARTTLS=true
