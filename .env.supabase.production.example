# Supabase-backed production environment. Copy to .env.supabase.production
# on the deployment host and chmod 600. Never commit the copied file.
VERIFACT_ENVIRONMENT=production
VERIFACT_MODE=production

# Public deployment and HTTPS
VERIFACT_DOMAIN=verifact.example
VERIFACT_TLS_EMAIL=admin@verifact.example
VERIFACT_FRONTEND_ORIGIN=https://verifact.example
VERIFACT_PUBLIC_BASE_URL=https://verifact.example
VERIFACT_ADDITIONAL_CORS_ORIGINS=
VERIFACT_ALLOWED_HOSTS=verifact.example
VERIFACT_SECURE_COOKIES=true
VERIFACT_SECRET_KEY=replace-with-a-unique-random-value-at-least-32-characters
VERIFACT_ACCESS_TOKEN_MINUTES=60

# Supabase PostgreSQL. Use the connection string from Supabase Connect.
# Keep the password URL-encoded. Include sslmode=require when the provider
# connection string does not already include SSL settings.
VERIFACT_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Redis remains local to the deployment host for the current RQ worker.
REDIS_PASSWORD=replace-with-a-strong-random-value
VERIFACT_REDIS_URL=redis://:replace-with-a-strong-random-value@verifact-redis:6379/0

# Operational limits
VERIFACT_SCORE_COVERAGE_THRESHOLD=0.60
VERIFACT_MAX_INPUT_CHARS=24000
VERIFACT_MAX_REQUEST_BYTES=300000
VERIFACT_REQUEST_TIMEOUT_SECONDS=45
VERIFACT_RATE_LIMIT_DEFAULT=120/minute
VERIFACT_RATE_LIMIT_AUTH=10/minute
VERIFACT_RATE_LIMIT_SIGNUP=5/minute
VERIFACT_SOURCE_POLICY_PATH=app/fixtures/source_policy.json

# OpenAI: create an API key at https://platform.openai.com/api-keys.
# Keep this key only on the backend host. Confirm billing/usage limits first.
VERIFACT_OPENAI_API_KEY=
VERIFACT_OPENAI_BASE_URL=https://api.openai.com/v1
VERIFACT_OPENAI_MODEL=gpt-4o-mini

# Evidence providers. Start with Google Fact Check and GDELT; add NewsAPI
# only after selecting a paid production plan and reviewing its terms.
VERIFACT_GOOGLE_FACTCHECK_KEY=
VERIFACT_NEWSAPI_KEY=
VERIFACT_GDELT_ENABLED=false

# Transactional email is required for real password-reset delivery.
VERIFACT_SMTP_HOST=
VERIFACT_SMTP_PORT=587
VERIFACT_SMTP_USERNAME=
VERIFACT_SMTP_PASSWORD=
VERIFACT_SMTP_FROM_EMAIL=no-reply@verifact.example
VERIFACT_SMTP_FROM_NAME=VeriFact
VERIFACT_SMTP_STARTTLS=true
