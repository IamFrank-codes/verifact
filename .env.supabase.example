# Supabase database connection. Use the transaction pooler URL for serverless
# deployments, or the direct connection URL for a long-running private server.
# Replace postgres:// or postgresql:// with the SQLAlchemy-compatible form below
# if you configure it directly: postgresql+psycopg://...
VERIFACT_DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase is the database only; Redis is still required for production workers.
VERIFACT_REDIS_URL=redis://:CHANGE_ME@redis-host:6379/0
