# VeriFact Academic Demo settings. Copy to backend/.env and keep it private.
# This profile sends submissions to configured live evidence providers.
# Run the frontend and FastAPI locally; no public host is required.
VERIFACT_ENVIRONMENT=development
VERIFACT_MODE=academic-demo
VERIFACT_INLINE_PROCESSING=true

# Use Supabase PostgreSQL, or keep the local SQLite URL for a self-contained demo.
VERIFACT_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
VERIFACT_SECRET_KEY=academic-demo-secret-change-this
VERIFACT_FRONTEND_ORIGIN=http://localhost:5173
VERIFACT_PUBLIC_BASE_URL=http://localhost:5173
VERIFACT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
VERIFACT_SECURE_COOKIES=false

# Groq structured evidence analysis through its OpenAI-compatible API.
# Set your Groq API key locally; never commit the populated key.
VERIFACT_OPENAI_API_KEY=
VERIFACT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
VERIFACT_OPENAI_MODEL=openai/gpt-oss-20b

# Prior published fact-check records.
VERIFACT_GOOGLE_FACTCHECK_KEY=

# News discovery. GDELT requires no API key.
VERIFACT_GDELT_ENABLED=true
# NewsAPI is optional; check the provider's terms and limits for your intended use.
VERIFACT_NEWSAPI_KEY=
# Optional testing mode: add Bing News RSS searches restricted to the selected sports publishers.
VERIFACT_SPORTS_SOURCE_SEARCH_ENABLED=false

# Required for real account-verification and password-reset email.
VERIFACT_SMTP_HOST=
VERIFACT_SMTP_PORT=587
VERIFACT_SMTP_USERNAME=
VERIFACT_SMTP_PASSWORD=
VERIFACT_SMTP_FROM_EMAIL=
VERIFACT_SMTP_FROM_NAME=VeriFact
VERIFACT_SMTP_STARTTLS=true
